{
  "mcpServers": {
    "pubmed": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cyanheads/pubmed-mcp-server@2.12.0"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "NCBI_API_KEY": "${NCBI_API_KEY:-}",
        "NCBI_EMAIL": "${NCBI_EMAIL:-}"
      }
    },
    "paperclip": {
      "type": "http",
      "url": "https://paperclip.gxl.ai/mcp"
    }
  }
}
